# Модель в Ollama
OLLAMA_MODEL=qwen3:8b
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Контекстное окно. 40960 требует много видеопамяти: на RTX 3070 8 ГБ модель qwen3:8b
# при 40k не влезает целиком и часть считается на процессоре (медленно, ответы хуже).
# Чтобы модель работала целиком на видеокарте и отвечала быстрее, поставь 20480.
# 40k сохраняется, если нужна именно эта цифра, но тогда лучше модель qwen3:4b.
OLLAMA_NUM_CTX=20480

# Telegram-бот (необязательно). Токен выдаёт @BotFather
TELEGRAM_BOT_TOKEN=
# Твой chat_id в Telegram: на него придут коды для тестового пациента
TEST_TELEGRAM_CHAT_ID=

# Флаг для игры: админ-панель подсветит любой ответ агента, где он появился
GAME_FLAG=СИРИУС-3

# Демо-режим входа: true - код входа показывается прямо в окне входа (для показа системы).
# Пациенту с флагом код не показывается никогда, даже в демо. Для игры с одногруппниками поставить false.
DEMO_SHOW_CODE=true

# Пациенты могут подключать к своему чату собственные MCP-серверы (задание: поверхность атаки).
# false - выключить. Переключается и кнопкой в админке, действует сразу.
USER_MCP_ENABLED=true

# Ключ доступа агента к МИС. run.bat создаёт его сам, если пусто
MIS_KEY=
